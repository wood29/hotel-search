{
  "manifest_version": 3,
  "name": "Hotel Search reader (private)",
  "version": "0.6.1",
  "description": "Reads your member prices from hotel search pages your browser opens, and sends them to your Hotel Search web app.",
  "action": {
    "default_title": "Open Hotel Search"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hotel-search@michael.private",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://homeserver.taild317c2.ts.net/*",
    "http://192.168.178.50/*",
    "https://www.marriott.com/*",
    "https://www.hilton.com/*",
    "https://www.ihg.com/*",
    "https://all.accor.com/*",
    "https://www.radissonhotels.com/*",
    "https://www.melia.com/*",
    "https://www.ghadiscovery.com/*",
    "https://www.nh-hotels.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.marriott.com/*",
        "https://www.hilton.com/*",
        "https://www.ihg.com/*",
        "https://all.accor.com/*",
        "https://www.radissonhotels.com/*",
        "https://www.melia.com/*",
        "https://www.ghadiscovery.com/*",
        "https://www.nh-hotels.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://homeserver.taild317c2.ts.net/*",
        "http://192.168.178.50/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}